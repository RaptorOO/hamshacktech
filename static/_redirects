# Code One with the CW Trainer (19 Nov 2026). Old tool links get a 301 to the
# CW Trainer hand-off page on this site, which moves people's saved progress
# (browser-only, under hamshacktech.com). Crawlers then get the crawler 301
# to Morse Code One, with the query kept. No Function handles /cw-tools, so
# these lines apply.
/cw-tools/icr-trainer            /cw-trainer/?tab=icr          301
/cw-tools/icr-trainer/           /cw-trainer/?tab=icr          301
/cw-tools/icr-trainer/*          /cw-trainer/?tab=icr          301
/cw-tools/code-groups-trainer    /cw-trainer/?tab=code-groups  301
/cw-tools/code-groups-trainer/   /cw-trainer/?tab=code-groups  301
/cw-tools/code-groups-trainer/*  /cw-trainer/?tab=code-groups  301
/cw-tools/morse-code-jeopardy    /cw-trainer/?tab=jeopardy     301
/cw-tools/morse-code-jeopardy/   /cw-trainer/?tab=jeopardy     301
/cw-tools/morse-code-jeopardy/*  /cw-trainer/?tab=jeopardy     301
